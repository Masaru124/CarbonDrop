# Database
DATABASE_URL=sqlite:///../carbondrop.db

# Local LLM parser for development
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava:latest
OLLAMA_TIMEOUT_SECONDS=60
# Set true for vision-capable models such as llava or llama3.2-vision.
OLLAMA_USE_IMAGES=true
# Optional: override the generate endpoint if your Ollama install exposes a different path
# e.g. '/api/generate' (default) or '/v1/generate' depending on your version
OLLAMA_GENERATE_PATH=/api/generate
# Optional: override the chat endpoint if your Ollama install exposes a different path
OLLAMA_CHAT_PATH=/api/chat
# Optional: health/status endpoint (used for debugging)
OLLAMA_HEALTH_PATH=/api/status

# Optional: only set if you use an external vision/LLM provider later
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# App secrets
JWT_SECRET=change-me
